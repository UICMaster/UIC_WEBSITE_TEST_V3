---
// src/components/home/AudioDeck.astro
const tracks = [
  { title: "UIC HYMNE - 2026 Q4", src: "/assets/audio/ULTRA_INSTINCT_CREW_ORGA_HYMNE_2026_2.mp3" },
  { title: "UIC HYMNE - 2026 Original", src: "/assets/audio/ULTRA_INSTINCT_CREW_ORGA_HYMNE_2026.mp3" },
  { title: "UIC HYMNE - 2026 Lagerfeuer", src: "/assets/audio/ULTRA_INSTINCT_CREW_ORGA_HYMNE_2026_FAM.mp3" },
  { title: "UIC HYMNE - 2025", src: "/assets/audio/ULTRA_INSTINCT_CREW_ORGA_HYMNE_2025.mp3" },
  { title: "UIC EMBER - 2026", src: "/assets/audio/ULTRA_INSTINCT_CREW_TEAM_EMBER_2026.mp3" },
  { title: "UIC CYBER - 2026", src: "/assets/audio/ULTRA_INSTINCT_CREW_TEAM_CYBER_2026.mp3" },
  { title: "UIC FREEZER - 2026", src: "/assets/audio/ULTRA_INSTINCT_CREW_TEAM_FREEZER_2026.mp3" },
  { title: "UIC VAKUUM - 2026", src: "/assets/audio/ULTRA_INSTINCT_CREW_TEAM_VAKUUM_2026.mp3" },
  { title: "UIC NIGHT - 2026", src: "/assets/audio/ULTRA_INSTINCT_CREW_TEAM_NIGHT_2026.mp3" }
];
---

<div id="uic-audio-widget" class="audio-widget is-collapsed" aria-label="UIC Audio Player">
  
  <audio id="hymn-audio-element" preload="none"></audio>

  <!-- Floating Pill (Always Visible) -->
  <div class="pill-bar">
    <button id="audio-pill-toggle" class="pill-trigger" title="Audio Player ein-/ausklappen" aria-label="Player erweitern" aria-expanded="false" aria-controls="expanded-audio-deck">
      <span class="equalizer-bars" aria-hidden="true">
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
      </span>
      <span id="current-track-label" class="pill-title text-mono">VEREINSHYMNEN</span>
    </button>

    <button id="pill-play-btn" class="pill-ctrl" aria-label="Play / Pause">
      <svg id="icon-pill-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      <svg id="icon-pill-pause" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
    </button>
  </div>

  <!-- Expanded Deck Window -->
  <div id="expanded-audio-deck" class="expanded-deck">
    <div class="deck-top">
      <div class="deck-brand text-mono">VEREINSHYMNEN</div>
      <button id="deck-close-btn" class="deck-btn-close" aria-label="Schließen">✕</button>
    </div>

    <!-- Progress Bar -->
    <div
      class="scrub-container"
      id="scrub-container"
      role="slider"
      tabindex="0"
      aria-label="Wiedergabefortschritt"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <div class="scrub-bg">
        <div id="scrub-fill" class="scrub-fill"></div>
      </div>
    </div>

    <div class="time-row text-mono">
      <span id="audio-curr-time">0:00</span>
      <span id="audio-duration">0:00</span>
    </div>

    <!-- Control Buttons -->
    <div class="deck-controls">
      <button id="btn-prev-track" class="btn-ctrl-icon" aria-label="Vorheriger Track">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
      </button>

      <button id="btn-main-play" class="btn-ctrl-play" aria-label="Abspielen">
        <svg id="icon-main-play" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        <svg id="icon-main-pause" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
      </button>

      <button id="btn-next-track" class="btn-ctrl-icon" aria-label="Nächster Track">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
      </button>
    </div>

    <!-- Playlist Selector -->
    <div class="deck-playlist">
      <span class="playlist-heading text-mono">TITELAUSWAHL</span>
      <ul class="playlist-items">
        {tracks.map((t, i) => (
          <li>
            <button class={`playlist-track ${i === 0 ? 'is-active' : ''}`} data-track-index={i}>
              <span class="track-number text-mono">0{i + 1}</span>
              <span class="track-name">{t.title}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>

</div>

<style>
  .audio-widget {
    position: fixed;
    bottom: calc(38px + var(--space-md));
    right: var(--space-lg);
    z-index: 999;
    font-family: var(--font-body);
  }

  .hidden {
    display: none !important;
  }

  /* Pill Bar */
  .pill-bar {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    background: rgba(11, 14, 21, 0.9);
    border: 1px solid var(--border-medium);
    backdrop-filter: blur(20px);
    border-radius: var(--radius-full);
    padding: 6px 10px 6px 14px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    transition: all var(--transition-fast);
  }

  .pill-bar:hover {
    border-color: var(--border-strong);
    background: rgba(17, 22, 33, 0.95);
  }

  .pill-trigger {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-white);
  }

  .pill-title {
    font-size: 0.75rem;
    font-weight: 700;
    max-width: 140px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pill-ctrl {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--text-white);
    color: var(--bg-void);
    transition: transform var(--transition-fast);
  }

  .pill-ctrl:hover {
    transform: scale(1.08);
  }

  /* Animated Equalizer */
  .equalizer-bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
  }

  .bar {
    width: 2px;
    background-color: var(--text-white);
    border-radius: 1px;
    height: 4px;
  }

  .is-playing .bar-1 { animation: eqBounce 0.8s infinite ease-in-out alternate; }
  .is-playing .bar-2 { animation: eqBounce 1.1s infinite ease-in-out alternate 0.2s; }
  .is-playing .bar-3 { animation: eqBounce 0.6s infinite ease-in-out alternate 0.4s; }

  @keyframes eqBounce {
    from { height: 3px; }
    to { height: 14px; }
  }

  /* Expanded Deck */
  .expanded-deck {
    display: none;
    position: absolute;
    bottom: calc(100% + 12px);
    right: 0;
    width: 320px;
    background: rgba(11, 14, 21, 0.96);
    border: 1px solid var(--border-medium);
    backdrop-filter: blur(24px);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.7);
    flex-direction: column;
    gap: var(--space-md);
    animation: fadeIn var(--transition-fast) forwards;
  }

  .audio-widget.is-expanded .expanded-deck {
    display: flex;
  }

  .deck-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-xs);
  }

  .deck-brand {
    font-size: 0.6875rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .deck-btn-close {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .deck-btn-close:hover {
    color: var(--text-white);
  }

  /* Progress scrub */
  .scrub-container {
    cursor: pointer;
    padding-block: 4px;
  }

  .scrub-bg {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    overflow: hidden;
  }

  .scrub-fill {
    width: 0%;
    height: 100%;
    background: var(--text-white);
    border-radius: 2px;
  }

  .time-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  /* Controls */
  .deck-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
  }

  .btn-ctrl-icon {
    color: var(--text-secondary);
  }
  .btn-ctrl-icon:hover {
    color: var(--text-white);
  }

  .btn-ctrl-play {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--text-white);
    color: var(--bg-void);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-fast);
  }

  .btn-ctrl-play:hover {
    transform: scale(1.06);
  }

  /* Playlist */
  .deck-playlist {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-sm);
  }

  .playlist-heading {
    font-size: 0.6875rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: var(--space-xs);
  }

  .playlist-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-height: 160px;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .playlist-track {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    width: 100%;
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    text-align: left;
    color: var(--text-secondary);
    font-size: 0.75rem;
  }

  .playlist-track:hover {
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-white);
  }

  .playlist-track.is-active {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-white);
    font-weight: 700;
  }

  .track-number {
    font-size: 0.625rem;
    color: var(--text-muted);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script is:inline define:vars={{ tracks }}>
  const widget = document.getElementById('uic-audio-widget');
  const audio = document.getElementById('hymn-audio-element');
  const pillToggle = document.getElementById('audio-pill-toggle');
  const pillPlayBtn = document.getElementById('pill-play-btn');
  const mainPlayBtn = document.getElementById('btn-main-play');
  const closeBtn = document.getElementById('deck-close-btn');
  const openExternalBtn = document.getElementById('open-audio-deck-btn');
  const prevBtn = document.getElementById('btn-prev-track');
  const nextBtn = document.getElementById('btn-next-track');
  const currentLabel = document.getElementById('current-track-label');
  const scrubContainer = document.getElementById('scrub-container');
  const scrubFill = document.getElementById('scrub-fill');
  const currTime = document.getElementById('audio-curr-time');
  const durTime = document.getElementById('audio-duration');
  const trackBtns = document.querySelectorAll('.playlist-track');

  let currentIdx = 0;
  let isPlaying = false;

  function loadTrack(idx) {
    if (!tracks[idx]) return;
    currentIdx = idx;
    audio.src = tracks[idx].src;
    currentLabel.textContent = tracks[idx].title;

    trackBtns.forEach((b, i) => {
      b.classList.toggle('is-active', i === idx);
    });
  }

  function togglePlay() {
    if (!audio.src) loadTrack(0);

    if (audio.paused) {
      audio.play().then(() => {
        isPlaying = true;
        updatePlayIcons(true);
      }).catch(e => console.log('Audio autoplay policy:', e));
    } else {
      audio.pause();
      isPlaying = false;
      updatePlayIcons(false);
    }
  }

  function updatePlayIcons(playing) {
    widget.classList.toggle('is-playing', playing);
    document.getElementById('icon-pill-play')?.classList.toggle('hidden', playing);
    document.getElementById('icon-pill-pause')?.classList.toggle('hidden', !playing);
    document.getElementById('icon-main-play')?.classList.toggle('hidden', playing);
    document.getElementById('icon-main-pause')?.classList.toggle('hidden', !playing);
  }

  function formatTime(s) {
    if (isNaN(s)) return '0:00';
    const mins = Math.floor(s / 60);
    const secs = Math.floor(s % 60);
    return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
  }

  // Event Listeners
  const setDeckExpanded = (expanded) => {
    widget.classList.toggle('is-expanded', expanded);
    pillToggle?.setAttribute('aria-expanded', expanded ? 'true' : 'false');
  };

  pillToggle?.addEventListener('click', () => {
    setDeckExpanded(!widget.classList.contains('is-expanded'));
  });

  closeBtn?.addEventListener('click', () => {
    setDeckExpanded(false);
  });

  openExternalBtn?.addEventListener('click', () => {
    setDeckExpanded(true);
    if (!isPlaying) togglePlay();
  });

  pillPlayBtn?.addEventListener('click', togglePlay);
  mainPlayBtn?.addEventListener('click', togglePlay);

  prevBtn?.addEventListener('click', () => {
    const next = (currentIdx - 1 + tracks.length) % tracks.length;
    loadTrack(next);
    audio.play();
    updatePlayIcons(true);
  });

  nextBtn?.addEventListener('click', () => {
    const next = (currentIdx + 1) % tracks.length;
    loadTrack(next);
    audio.play();
    updatePlayIcons(true);
  });

  trackBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-track-index'));
      loadTrack(idx);
      audio.play();
      updatePlayIcons(true);
    });
  });

  audio.addEventListener('timeupdate', () => {
    if (audio.duration) {
      const pct = (audio.currentTime / audio.duration) * 100;
      if (scrubFill) scrubFill.style.width = `${pct}%`;
      if (scrubContainer) scrubContainer.setAttribute('aria-valuenow', String(Math.round(pct)));
      if (currTime) currTime.textContent = formatTime(audio.currentTime);
      if (durTime) durTime.textContent = formatTime(audio.duration);
    }
  });

  audio.addEventListener('ended', () => {
    const next = (currentIdx + 1) % tracks.length;
    loadTrack(next);
    audio.play();
  });

  scrubContainer?.addEventListener('click', (e) => {
    const rect = scrubContainer.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const pct = clickX / rect.width;
    if (audio.duration) {
      audio.currentTime = pct * audio.duration;
    }
  });

  scrubContainer?.addEventListener('keydown', (e) => {
    if (!audio.duration) return;
    if (e.key === 'ArrowRight') {
      e.preventDefault();
      audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      audio.currentTime = Math.max(0, audio.currentTime - 5);
    }
  });
</script>
