---
// src/pages/honored/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { honoredPlayers, type HonoredPlayerDossier } from '../../utils/honoredData';

export function getStaticPaths() {
  return honoredPlayers.map((player) => ({
    params: { slug: player.slug },
    props: { player }
  }));
}

interface Props {
  player: HonoredPlayerDossier;
}

const { player } = Astro.props;
const firstVoice = player.voiceClips[0] || null;
const firstVideo = player.videos[0] || null;
---

<Layout
  title={`${player.name} – Ruhmeshalle | Ultra Instinct Crew`}
  description={`Ruhmeshalle der Ultra Instinct Crew: Werdegang, Biografie, Sprachaufnahmen und gespielte Splits von ${player.name}.`}
>
  <div class="hall-page section-pad">
    <div class="container hall-container">

      <!-- Top Navigation Bar -->
      <nav class="hall-topbar" aria-label="Ruhmeshalle Navigation">
        <div class="topbar-left">
          <a href="/#teams" class="nav-chip text-mono">&larr; ZURÜCK ZU DEN TEAMS</a>
          <a href="/honored" class="nav-chip text-mono">ALLE MITGLIEDER DER RUHMESHALLE</a>
        </div>

        <div class="topbar-right text-mono">
          <span class="serial-lbl">#{player.playerId}</span>
          <span class="sep">&bull;</span>
          <span>
            AUFGENOMMEN AM <time datetime={player.inductedAtRaw}>{player.inductedAtFormatted}</time>
          </span>
        </div>
      </nav>

      <!-- =====================================================================
           1. HERO PROFILE CARD (Portrait Left | Identity & Phrases Right)
           ===================================================================== -->
      <section class="hero-profile-card" aria-label="Persönliches Profil">
        <!-- Left: Clean Edge-to-Edge Portrait (matching main page aesthetic) -->
        <div class="hero-portrait-stage">
          <div class="portrait-badges text-mono">
            <span class="crown-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"/></svg>
              <span>RUHMESHALLE</span>
            </span>
          </div>

          <img
            src={player.photoSrc}
            alt={`Porträt von ${player.name}`}
            class="portrait-img"
            width="360"
            height="400"
            decoding="async"
            onerror="this.src='/assets/profile/profile_placeholder.png'"
          />
          <div class="portrait-shade"></div>
        </div>

        <!-- Right: Identity, Timestamp & Phrases -->
        <div class="hero-identity-body">
          <div class="identity-top">
            <div class="meta-pills-row text-mono">
              <span class="meta-pill">
                AUFNAHME: <time datetime={player.inductedAtRaw}>{player.inductedAtFormatted}</time>
              </span>

              {player.primeLeagueUserUrl && (
                <a
                  href={player.primeLeagueUserUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="meta-pill meta-pill-link"
                  title="Offizielles Prime League Profil öffnen"
                >
                  <span>PRIME LEAGUE: {player.primeLeagueAccountName || `#${player.primeLeagueUserId}`}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>

            <h1 class="person-name">{player.name}</h1>
            <p class="person-title">{player.title}</p>
          </div>

          <!-- Phrases / Quotes -->
          <div class="phrases-section">
            <span class="block-label text-mono">SPRÜCHE & ZITATE</span>
            {player.phrases.length > 0 ? (
              <div class="phrases-grid">
                {player.phrases.map((phrase) => (
                  <blockquote class="phrase-card">
                    <p>„{phrase}“</p>
                  </blockquote>
                ))}
              </div>
            ) : (
              <p class="placeholder-text">[Platzhalter: Keine Sprüche hinterlegt]</p>
            )}
          </div>
        </div>
      </section>

      <!-- =====================================================================
           2. STANDALONE SLIM & WIDE GLASSMORPHISM AUDIO PLAYER (Outside the box)
           ===================================================================== -->
      <section class="standalone-audio-bar" aria-label="Audio-Player für Sprachaufnahmen">
        {firstVoice ? (
          <>
            <audio id="gad-audio" preload="none" src={firstVoice.src}></audio>

            <!-- Left: Transport Controls & Active Track Info -->
            <div class="sab-left">
              <div class="sab-controls">
                <button
                  type="button"
                  id="gad-prev-btn"
                  class="sab-icon-btn"
                  aria-label="Vorherige Aufnahme"
                  title="Vorherige Aufnahme"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
                </button>

                <button
                  type="button"
                  id="gad-play-btn"
                  class="sab-play-btn"
                  aria-label="Abspielen oder Pausieren"
                >
                  <svg id="gad-icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  <svg id="gad-icon-pause" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                </button>

                <button
                  type="button"
                  id="gad-next-btn"
                  class="sab-icon-btn"
                  aria-label="Nächste Aufnahme"
                  title="Nächste Aufnahme"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
                </button>
              </div>

              <div class="sab-track-meta">
                <div class="sab-title-row">
                  <span class="sab-eq" id="gad-visualizer" aria-hidden="true">
                    <span class="eq-b"></span><span class="eq-b"></span><span class="eq-b"></span><span class="eq-b"></span>
                  </span>
                  <span id="gad-current-title" class="sab-title">{firstVoice.title}</span>
                </div>
                <span id="gad-current-ctx" class="sab-ctx text-mono">{firstVoice.context || 'Sprachaufnahme'}</span>
              </div>
            </div>

            <!-- Center: Wide Scrubbing Bar & Timecode -->
            <div class="sab-center">
              <span id="gad-time-cur" class="sab-time text-mono">0:00</span>
              <div
                id="gad-scrub"
                class="sab-scrub"
                role="slider"
                tabindex="0"
                aria-label="Audio-Fortschritt"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
              >
                <div id="gad-scrub-fill" class="sab-scrub-fill"></div>
              </div>
              <span id="gad-time-dur" class="sab-time text-mono">0:00</span>
            </div>

            <!-- Right: Track Selector Pills & Mute -->
            <div class="sab-right">
              {player.voiceClips.length > 1 && (
                <div class="sab-pills" role="list" aria-label="Sprachaufnahmen auswählen">
                  {player.voiceClips.map((vc, idx) => (
                    <button
                      type="button"
                      class={`sab-pill text-mono gad-track-item ${idx === 0 ? 'is-active' : ''}`}
                      data-track-index={idx}
                      data-voice-src={vc.src}
                      data-voice-title={vc.title}
                      data-voice-ctx={vc.context || 'Sprachaufnahme'}
                    >
                      #{idx + 1}
                    </button>
                  ))}
                </div>
              )}

              <button
                type="button"
                id="gad-mute-btn"
                class="sab-icon-btn"
                aria-label="Stummschalten"
                title="Ton ein/aus"
              >
                <svg id="gad-icon-vol" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
                <svg id="gad-icon-muted" class="hidden" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
              </button>
            </div>
          </>
        ) : (
          <div class="sab-empty text-mono">
            [Platzhalter: Keine Audiodateien hinterlegt]
          </div>
        )}
      </section>

      <!-- =====================================================================
           3. WIDE BIOGRAPHY (With Titles, Subtitles & Chapters) + IMPACT & WERDEGANG
           ===================================================================== -->
      <section class="bio-and-impact-grid" aria-label="Biografie, Einfluss und Werdegang">
        <!-- Wide Biography Card (Left) -->
        <article class="bento-card bio-card">
          <div class="card-head">
            <span class="block-label text-mono">ÜBER DIE PERSON</span>
            <h2 class="card-title">BIOGRAFIE & HINTERGRUND</h2>
          </div>

          {player.bioLead && (
            <p class="bio-lead">{player.bioLead}</p>
          )}

          <div class="bio-chapters">
            {player.bioSections.map((section) => (
              <div class="bio-chapter">
                {section.subtitle && (
                  <span class="chapter-subtitle text-mono">{section.subtitle}</span>
                )}
                <h3 class="chapter-title">{section.title}</h3>
                <div class="chapter-paragraphs">
                  {section.paragraphs.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </article>

        <!-- Impact & Milestones Stack (Right) -->
        <div class="side-stack">
          <!-- Impact on the Organisation -->
          <div class="bento-card">
            <div class="card-head">
              <span class="block-label text-mono">EINFLUSS AUF DIE ORGANISATION</span>
              <h3 class="card-subtitle">BEITRAG FÜR VEREIN & COMMUNITY</h3>
            </div>

            <ul class="impact-list">
              {player.impact.map((point, idx) => (
                <li class="impact-item">
                  <span class="impact-num text-mono">{String(idx + 1).padStart(2, '0')}</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Milestones (Werdegang) -->
          {player.milestones.length > 0 && (
            <div class="bento-card">
              <div class="card-head">
                <span class="block-label text-mono">WERDEGANG</span>
                <h3 class="card-subtitle">STATIONEN & MEILENSTEINE</h3>
              </div>

              <div class="milestones-list">
                {player.milestones.map((ms) => (
                  <div class="ms-row">
                    <span class="ms-date text-mono">{ms.date}</span>
                    <div class="ms-body">
                      <strong class="ms-label">{ms.label}</strong>
                      {ms.detail && <p class="ms-detail">{ms.detail}</p>}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>

      <!-- =====================================================================
           4. 50/50 SPLIT: PRIME LEAGUE SPLITS ROADMAP (LEFT) & VIDEO AREA (RIGHT)
           ===================================================================== -->
      <section class="split-two-col" aria-label="Gespielte Splits und Video-Bereich">
        <!-- Left Half: Splits Roadmap -->
        <div class="bento-card">
          <div class="card-head-flex">
            <div>
              <span class="block-label text-mono">ROADMAP & EINSÄTZE</span>
              <h2 class="card-title">GESPIELTE PRIME LEAGUE SPLITS</h2>
            </div>

            {player.primeLeagueUserUrl && (
              <a
                href={player.primeLeagueUserUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="ext-pill text-mono"
              >
                <span>Prime League Akte</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>

          <div class="roadmap-list">
            {player.seasons.map((s, idx) => (
              <div class="roadmap-item">
                <div class="rm-rail">
                  <span class="rm-idx text-mono">{String(idx + 1).padStart(2, '0')}</span>
                  {idx < player.seasons.length - 1 && <span class="rm-line"></span>}
                </div>

                <div class="rm-card">
                  <div class="rm-top text-mono">
                    <span class="rm-season">{s.season}</span>
                    <span class={`rm-badge ${s.source === 'api' ? 'is-api' : ''}`}>
                      {s.source === 'api' ? 'API-SYNC' : 'CHRONIK'}
                    </span>
                  </div>

                  <div class="rm-team-row">
                    <div class="name-with-link">
                      <h3 class="rm-team">{s.team}</h3>
                      {s.teamLink && (
                        <a
                          href={s.teamLink}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="link-forward-arrow"
                          title={`${s.team} auf Prime League öffnen`}
                          aria-label={`${s.team} auf Prime League öffnen`}
                        >
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                      )}
                    </div>
                    {s.division && <span class="rm-div text-mono">{s.division}</span>}
                  </div>

                  {s.note && <p class="rm-note">{s.note}</p>}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right Half: Video Area -->
        <div class="bento-card">
          <div class="card-head">
            <span class="block-label text-mono">BEWEGTBILD & HIGHLIGHTS</span>
            <h2 class="card-title">VIDEO-BEREICH</h2>
          </div>

          {firstVideo ? (
            <div class="video-stack">
              <div class="video-frame">
                <video
                  id="hall-video-el"
                  controls
                  preload="metadata"
                  poster={firstVideo.poster}
                  class="video-el"
                  src={firstVideo.src}
                >
                  Dein Browser unterstützt das Video-Element nicht.
                </video>
              </div>

              <div class="video-info-box">
                <h3 id="hall-video-title" class="video-title">{firstVideo.title}</h3>
                <p id="hall-video-desc" class="video-desc">{firstVideo.description || ''}</p>
              </div>

              {player.videos.length > 1 && (
                <div class="video-pills">
                  {player.videos.map((vid, idx) => (
                    <button
                      type="button"
                      class={`cinema-pill text-mono ${idx === 0 ? 'is-active' : ''}`}
                      data-vid-index={idx}
                      data-vid-src={vid.src}
                      data-vid-title={vid.title}
                      data-vid-desc={vid.description || ''}
                    >
                      #{idx + 1} {vid.title}
                    </button>
                  ))}
                </div>
              )}
            </div>
          ) : (
            <p class="placeholder-text">[Platzhalter: Kein Video in data/honored.json hinterlegt]</p>
          )}
        </div>
      </section>

      <!-- =====================================================================
           5. IMAGES & GALLERY SECTION (Bilder & Eindrücke)
           ===================================================================== -->
      <section class="bento-card gallery-section" aria-label="Bilder und Galerie">
        <div class="card-head-flex">
          <div>
            <span class="block-label text-mono">ARCHIV & IMPRESSIONEN</span>
            <h2 class="card-title">BILDER & MOMENTE</h2>
          </div>
          <span class="gallery-count text-mono">{player.images.length} AUFNAHMEN</span>
        </div>

        {player.images.length > 0 ? (
          <div class="gallery-grid">
            {player.images.map((img) => (
              <figure class="gallery-item">
                <div class="gallery-img-wrap">
                  <img
                    src={img.src}
                    alt={img.title || img.caption || `Bild von ${player.name}`}
                    class="gallery-img"
                    loading="lazy"
                    decoding="async"
                    onerror="this.src='/assets/profile/profile_placeholder.png'"
                  />
                  {img.date && <span class="gallery-date text-mono">{img.date}</span>}
                </div>
                {(img.title || img.caption) && (
                  <figcaption class="gallery-caption">
                    {img.title && <strong class="gallery-item-title">{img.title}</strong>}
                    {img.caption && <p class="gallery-item-desc">{img.caption}</p>}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        ) : (
          <p class="placeholder-text">[Platzhalter: Keine Bilder in data/honored.json hinterlegt]</p>
        )}
      </section>

    </div>
  </div>
</Layout>

<script>
  // Standalone Slim Glassmorphism Audio Bar Controller
  const audio = document.getElementById('gad-audio') as HTMLAudioElement | null;
  const playBtn = document.getElementById('gad-play-btn');
  const prevBtn = document.getElementById('gad-prev-btn');
  const nextBtn = document.getElementById('gad-next-btn');
  const muteBtn = document.getElementById('gad-mute-btn');
  const iconPlay = document.getElementById('gad-icon-play');
  const iconPause = document.getElementById('gad-icon-pause');
  const iconVol = document.getElementById('gad-icon-vol');
  const iconMuted = document.getElementById('gad-icon-muted');
  const visualizer = document.getElementById('gad-visualizer');
  const curTitle = document.getElementById('gad-current-title');
  const curCtx = document.getElementById('gad-current-ctx');
  const timeCur = document.getElementById('gad-time-cur');
  const timeDur = document.getElementById('gad-time-dur');
  const scrub = document.getElementById('gad-scrub');
  const scrubFill = document.getElementById('gad-scrub-fill');
  const trackItems = Array.from(document.querySelectorAll('.gad-track-item'));

  let currentTrackIdx = 0;

  function formatTime(sec: number): string {
    if (!isFinite(sec) || sec < 0) return '0:00';
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return `${m}:${s < 10 ? '0' : ''}${s}`;
  }

  function loadTrack(idx: number, autoPlay = true) {
    if (!audio || trackItems.length === 0) return;
    currentTrackIdx = (idx + trackItems.length) % trackItems.length;
    const target = trackItems[currentTrackIdx];
    trackItems.forEach((btn, i) => btn.classList.toggle('is-active', i === currentTrackIdx));

    const src = target.getAttribute('data-voice-src');
    const title = target.getAttribute('data-voice-title');
    const ctx = target.getAttribute('data-voice-ctx');

    if (src) audio.src = src;
    if (curTitle && title) curTitle.textContent = title;
    if (curCtx) curCtx.textContent = ctx || '';
    if (scrubFill) scrubFill.style.width = '0%';

    if (autoPlay) {
      audio.play().catch(() => {});
    }
  }

  if (audio && playBtn) {
    const syncState = () => {
      const playing = !audio.paused;
      iconPlay?.classList.toggle('hidden', playing);
      iconPause?.classList.toggle('hidden', !playing);
      visualizer?.classList.toggle('is-playing', playing);
    };

    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play().catch(() => {});
      } else {
        audio.pause();
      }
    });

    prevBtn?.addEventListener('click', () => loadTrack(currentTrackIdx - 1, true));
    nextBtn?.addEventListener('click', () => loadTrack(currentTrackIdx + 1, true));

    muteBtn?.addEventListener('click', () => {
      audio.muted = !audio.muted;
      iconVol?.classList.toggle('hidden', audio.muted);
      iconMuted?.classList.toggle('hidden', !audio.muted);
    });

    audio.addEventListener('play', syncState);
    audio.addEventListener('pause', syncState);
    audio.addEventListener('ended', () => {
      syncState();
      if (trackItems.length > 1) {
        loadTrack(currentTrackIdx + 1, true);
      }
    });

    audio.addEventListener('timeupdate', () => {
      const c = audio.currentTime || 0;
      const d = audio.duration || 0;
      if (timeCur) timeCur.textContent = formatTime(c);
      if (timeDur && d > 0) timeDur.textContent = formatTime(d);
      if (scrubFill && d > 0) {
        const pct = Math.min(100, Math.round((c / d) * 100));
        scrubFill.style.width = `${pct}%`;
        scrub?.setAttribute('aria-valuenow', String(pct));
      }
    });

    audio.addEventListener('loadedmetadata', () => {
      if (timeDur) timeDur.textContent = formatTime(audio.duration || 0);
    });

    scrub?.addEventListener('click', (e) => {
      const rect = scrub.getBoundingClientRect();
      const ratio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      if (audio.duration) {
        audio.currentTime = ratio * audio.duration;
      }
    });

    scrub?.addEventListener('keydown', (e) => {
      if (!audio.duration) return;
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        audio.currentTime = Math.max(0, audio.currentTime - 5);
      }
    });

    trackItems.forEach((btn, idx) => {
      btn.addEventListener('click', () => loadTrack(idx, true));
    });
  }

  // Video Switcher
  const videoEl = document.getElementById('hall-video-el') as HTMLVideoElement | null;
  const videoTitle = document.getElementById('hall-video-title');
  const videoDesc = document.getElementById('hall-video-desc');
  const videoPills = Array.from(document.querySelectorAll('.cinema-pill'));

  if (videoEl && videoPills.length > 0) {
    videoPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        videoPills.forEach((p) => p.classList.remove('is-active'));
        pill.classList.add('is-active');
        const src = pill.getAttribute('data-vid-src');
        const title = pill.getAttribute('data-vid-title');
        const desc = pill.getAttribute('data-vid-desc');
        if (src) {
          videoEl.src = src;
          videoEl.load();
        }
        if (videoTitle && title) videoTitle.textContent = title;
        if (videoDesc) videoDesc.textContent = desc || '';
      });
    });
  }
</script>

<style>
  .hall-page {
    padding-top: 8.5rem;
    padding-bottom: 7rem;
    min-height: 100vh;
    background-color: #000000;
  }

  .hall-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* Top Navigation Bar */
  .hall-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .nav-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.5rem 1rem;
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .nav-chip:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    color: var(--text-muted);
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
  }

  .serial-lbl {
    color: #ffffff;
    font-weight: 800;
  }

  .topbar-right time {
    color: #ffffff;
    font-weight: 700;
  }

  /* =====================================================================
     1. HERO PROFILE CARD (Clean Main-Page Aesthetic)
     ===================================================================== */
  .hero-profile-card {
    display: grid;
    grid-template-columns: 320px 1fr;
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
